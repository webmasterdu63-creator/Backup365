### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
#Cache folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-file
*.flf
#Test results file
TestResults.xml
# --- SÉCURITÉ (À NE JAMAIS ENVOYER) ---
.env
*.pem
*.key
secrets.json

# --- DONNÉES DE SAUVEGARDE ---
# On ignore le dossier où les sauvegardes sont réellement stockées
backups/
temp_data/
*.zip
*.tar.gz

# --- PYTHON (si utilisé) ---
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# --- LOGS ---
logs/
*.log

# --- SYSTÈME ---
.DS_Store
Thumbs.db
